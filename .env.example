# ── Phase 2 only (not needed for the phase-1 frontend/mock build) ──

# MongoDB — stores the daily dialogues
MONGODB_URI=

# OpenAI — daily dialogue generation + TTS audio
OPENAI_API_KEY=

# Cloudflare R2 — hosts the generated audio files (egress-free)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL for serving audio (R2 public bucket or custom domain)
R2_PUBLIC_BASE_URL=

# Optional 2nd TTS voice for speaker B (default: nova)
OPENAI_TTS_VOICE_B=nova

# Protects /api/generate. Vercel Cron sends "Authorization: Bearer <this>".
# Generate one with: openssl rand -hex 32
CRON_SECRET=
